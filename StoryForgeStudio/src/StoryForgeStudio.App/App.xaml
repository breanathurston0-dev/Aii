<Application x:Class="StoryForgeStudio.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Modern Dark Slate Theme Palette -->
            <SolidColorBrush x:Key="BackgroundBrush" Color="#0B0F19" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#151D2F" />
            <SolidColorBrush x:Key="BorderBrush" Color="#223049" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F1F5F9" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#94A3B8" />
            <SolidColorBrush x:Key="AccentBrush" Color="#6366F1" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#4F46E5" />

            <!-- Global Style Defaults -->
            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI, Noto Sans Khmer" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Background" Value="#090D16" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="Padding" Value="8,5" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
