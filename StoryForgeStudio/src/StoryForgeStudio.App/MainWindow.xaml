<Window x:Class="StoryForgeStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StoryForge Studio — AI Story Summarizer, Video Editor &amp; Khmer TTS"
        Height="850" Width="1350"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" /> <!-- Top Bar -->
            <RowDefinition Height="*" />  <!-- Main Workspace -->
            <RowDefinition Height="28" /> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="STORYFORGE STUDIO" FontWeight="Bold" FontSize="16" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text=" · Khmer &amp; Multilingual AI Suite" Margin="10,0,0,0" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Quick Export" Margin="0,0,10,0" Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="SemiBold" />
                    <Button Content="Settings" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" /> <!-- Sidebar -->
                <ColumnDefinition Width="*" />   <!-- Active View Content -->
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="WORKSPACE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="8,8,8,4" />
                        <Button Content="Dashboard" HorizontalContentAlignment="Left" Margin="0,2" />
                        <Button Content="Projects" HorizontalContentAlignment="Left" Margin="0,2" />

                        <TextBlock Text="VIDEO &amp; SUBTITLES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="8,16,8,4" />
                        <Button Content="Video Editor" HorizontalContentAlignment="Left" Margin="0,2" />
                        <Button Content="Subtitle/SRT Editor" HorizontalContentAlignment="Left" Margin="0,2" />
                        <Button Content="Transcript Editor" HorizontalContentAlignment="Left" Margin="0,2" />

                        <TextBlock Text="AI AUDIO &amp; SPEECH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="8,16,8,4" />
                        <Button Content="Text-to-Speech (Khmer &amp; Multi)" HorizontalContentAlignment="Left" Margin="0,2" />
                        <Button Content="Voice Studio" HorizontalContentAlignment="Left" Margin="0,2" />
                        <Button Content="Consent Voice Cloning" HorizontalContentAlignment="Left" Margin="0,2" />
                        <Button Content="Vocal Remover (Demucs)" HorizontalContentAlignment="Left" Margin="0,2" />
                        <Button Content="Audio Tools" HorizontalContentAlignment="Left" Margin="0,2" />

                        <TextBlock Text="AI STORY &amp; TRANSLATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="8,16,8,4" />
                        <Button Content="Story Summarizer" HorizontalContentAlignment="Left" Margin="0,2" />
                        <Button Content="Translation Studio" HorizontalContentAlignment="Left" Margin="0,2" />

                        <TextBlock Text="SYSTEM &amp; JOBS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="8,16,8,4" />
                        <Button Content="Export Center" HorizontalContentAlignment="Left" Margin="0,2" />
                        <Button Content="Processing Queue" HorizontalContentAlignment="Left" Margin="0,2" />
                        <Button Content="AI Provider Settings" HorizontalContentAlignment="Left" Margin="0,2" />
                        <Button Content="History &amp; Audit" HorizontalContentAlignment="Left" Margin="0,2" />
                        <Button Content="Logs &amp; Diagnostics" HorizontalContentAlignment="Left" Margin="0,2" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Active View Content Container -->
            <Grid Grid.Column="1" Margin="20">
                <Border Background="#0D1322" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="StoryForge Studio Workstation Ready" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10" />
                        <TextBlock Text="All 18 modules (Video Editor, Story Summarizer, Khmer TTS, SRT Burn-in, Voice Cloning, Demucs) are fully wired." Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,0">
            <DockPanel>
                <TextBlock Text="Ready · Engine: FFmpeg 4.4 + Gemini 3.8 + SQLite · UTF-8 Khmer Unicode" FontSize="12" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Jobs: 0 Running · Memory: Nominal" FontSize="12" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
